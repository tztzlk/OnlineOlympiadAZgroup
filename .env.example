APP_NAME="Online Olympiad"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
SEO_SITE_URL=http://127.0.0.1:8000
SEO_SITE_NAME="Online Olympiad"
SEO_LANG=ru-KZ
SEO_LOCALE=ru_KZ
SEO_DEFAULT_IMAGE=/welcome.png

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=online_olympiad
DB_USERNAME=root
DB_PASSWORD=
# DATABASE_URL=

# Same-origin launch default:
# - Laravel serves the SPA and API from one domain
# - current auth flow is Sanctum personal access tokens stored in localStorage
# - cookie settings still matter for a future migration, but v1 auth is bearer-token based
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Hostnames only. No scheme, no path.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# First production launch target: database queue.
QUEUE_CONNECTION=database

# Use database or redis in production. Keep local simple unless Redis is running.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_QUEUE=default
# REDIS_CACHE_DB=1

# Replace with a real transactional mail provider before production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE="+7 (777) 000-00-00"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend build-time variables. Set VITE_API_URL explicitly before npm run build.
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://127.0.0.1:8000/api
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE="+7 (777) 000-00-00"
VITE_KASPI_PAYMENT_URL="https://kaspi.kz/pay/_gate?action=service_with_subservice&service_id=3025&subservice_id=22909&region_id=19"

KASPI_PAYMENT_URL="https://kaspi.kz/pay/_gate?action=service_with_subservice&service_id=3025&subservice_id=22909&region_id=19"
YOOKASSA_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Security and deployment hardening
SECURITY_ENFORCE_HTTPS=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_PRELOAD=true
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
SECURITY_CSP="default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://kaspi.kz; object-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https: wss:;"
SECURITY_STRIPE_WEBHOOK_TOLERANCE=300
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
SECURITY_DENIED_THRESHOLD_PER_MINUTE=10
SECURITY_IP_REQUEST_THRESHOLD_PER_MINUTE=300
SECURITY_GLOBAL_REQUEST_THRESHOLD_PER_MINUTE=2000
SECURITY_LOG_LEVEL=info
ANOMALY_LOG_LEVEL=warning

# Preview environment isolation
VERCEL_ENV=development
PRODUCTION_DATABASE_URL=
PRODUCTION_DB_HOST=
PRODUCTION_DB_DATABASE=
