APP_NAME="Online Olympiad"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Security and deployment hardening
SECURITY_ENFORCE_HTTPS=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_PRELOAD=true
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
SECURITY_CSP="default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://kaspi.kz; script-src 'self' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:;"
SECURITY_STRIPE_WEBHOOK_TOLERANCE=300
CORS_ALLOWED_ORIGINS=http://localhost:8000
SECURITY_DENIED_THRESHOLD_PER_MINUTE=10
SECURITY_IP_REQUEST_THRESHOLD_PER_MINUTE=300
SECURITY_GLOBAL_REQUEST_THRESHOLD_PER_MINUTE=2000
SECURITY_LOG_LEVEL=info
ANOMALY_LOG_LEVEL=warning

# Vercel / environment isolation
VERCEL_ENV=development
PRODUCTION_DATABASE_URL=
PRODUCTION_DB_HOST=
PRODUCTION_DB_DATABASE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=online_olympiad
DB_USERNAME=root
DB_PASSWORD=
# DATABASE_URL=

# --- Session, Cache, Queue & Sanctum ---
# Production defaults assume same-origin deployment on one domain and Redis for
# sessions, cache, and queues. For local development without Redis, you can
# switch these drivers back to `database`.
# SESSION_DOMAIN should be your public host (for example, `example.com`) or
# `.example.com` if you need cookie sharing across subdomains.
# SANCTUM_STATEFUL_DOMAINS must contain hostnames only, with no scheme or path.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_QUEUE=default
# REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite (frontend build-time) ---
# In production, set VITE_API_URL explicitly to your full API base (e.g. https://your-domain.com/api).
# Required before running npm run build.
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api
KASPI_PAYMENT_URL="https://kaspi.kz/pay/_gate?action=service_with_subservice&service_id=3025&subservice_id=22909&region_id=19"
YOOKASSA_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
