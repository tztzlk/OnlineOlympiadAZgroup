APP_NAME="Online Olympiad"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL — основная БД проекта.
# Приложение должно подключаться отдельной ролью без прав суперпользователя
# (см. database/postgres/setup.sql).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=online_olympiad
DB_USERNAME=olympiad_app
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_TOKEN_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

MAIL_MAILER=log
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=

SECURITY_ENFORCE_HTTPS=false
# Оставьте пустым, только если прокси (Cloudflare) сам добавляет X-Frame-Options.
SECURITY_X_FRAME_OPTIONS=DENY

YOOKASSA_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

VITE_APP_NAME="${APP_NAME}"
