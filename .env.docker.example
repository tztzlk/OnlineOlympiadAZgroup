# Переменные для docker compose. Скопируйте в .env.docker и задайте APP_KEY:
#   php artisan key:generate --show
# Подключение к БД и почте задаётся в docker-compose.yml.

APP_NAME="Eurika"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stderr
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

SECURITY_ENFORCE_HTTPS=false

MAIL_FROM_ADDRESS=noreply@eurika.local
MAIL_FROM_NAME="Eurika"
SUPPORT_EMAIL=eurica001olimp@gmail.com
