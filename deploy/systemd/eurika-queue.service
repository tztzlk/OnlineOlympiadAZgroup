[Unit]
Description=Eurika queue worker (письма и уведомления)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=__APP_DIR__
ExecStart=/usr/bin/php __APP_DIR__/artisan queue:work --sleep=3 --tries=3 --max-time=3600 --memory=256
Restart=always
RestartSec=5
# Ограничения на случай компрометации процесса
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
