# Шаблон .env для боевого сервера. Скрипт deploy/install-server.sh заполняет
# значения __В_ТАКОМ_ВИДЕ__ сам. Вручную нужно задать только почту (MAIL_*).

APP_NAME="Eurika"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__
FRONTEND_URL=https://__DOMAIN__
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=online_olympiad
DB_USERNAME=olympiad_app
DB_PASSWORD=__DB_PASSWORD__
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=__DOMAIN__

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=__DOMAIN__,www.__DOMAIN__
CORS_ALLOWED_ORIGINS=https://__DOMAIN__,https://www.__DOMAIN__

# HTTPS включается скриптом после получения сертификата Let's Encrypt.
SECURITY_ENFORCE_HTTPS=__ENFORCE_HTTPS__
SECURITY_X_FRAME_OPTIONS=DENY

SEO_SITE_NAME="Eurika"
SEO_SITE_URL=https://__DOMAIN__

# Почта: без неё не работают восстановление пароля и письма-уведомления.
# Пример для Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, пароль приложения Google.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=eurica001olimp@gmail.com
MAIL_FROM_NAME="Eurika"
SUPPORT_EMAIL=eurica001olimp@gmail.com
SUPPORT_PHONE="+7 (700) 033-02-26"
VITE_SUPPORT_EMAIL=eurica001olimp@gmail.com
VITE_SUPPORT_PHONE="+7 (700) 033-02-26"

KASPI_PAYMENT_URL="https://kaspi.kz/pay/_gate?action=service_with_subservice&service_id=3025&subservice_id=22909&region_id=19"
KASPI_CALLBACK_SECRET=

YOOKASSA_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
